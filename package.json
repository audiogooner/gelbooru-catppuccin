{
  "name": "gelbooru-userstyle",
  "private": true,
  "type": "module",
  "description": "Catppuccin Mocha UserStyle for Gelbooru",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "export": "node scripts/export.mjs",
    "lint:styles": "node scripts/lint-styles.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check": "npm test && node scripts/doctor.mjs && node scripts/lint-styles.mjs",
    "snapshot:fetch": "node scripts/fetch-snapshots.mjs",
    "preview:install": "node scripts/install-selector-preview.mjs"
  },
  "devDependencies": {
    "html2canvas": "^1.4.1",
    "linkedom": "^0.18.12",
    "sass": "^1.90.0",
    "source-map-js": "^1.2.1"
  }
}
