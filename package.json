{
  "name": "gelbooru-userstyle",
  "private": true,
  "type": "module",
  "description": "Catppuccin Mocha UserStyle for Gelbooru",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "userstyle-dev dev",
    "export": "userstyle-dev export",
    "lint:styles": "userstyle-dev lint",
    "doctor": "userstyle-dev doctor",
